# =============================================================================
# BEA AI ASSESSMENT & ANSWER SCRIPT EVALUATION SYSTEM
# Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GITHUB
# =============================================================================

# Flask Application
FLASK_ENV=development
FLASK_APP=app.py
FLASK_SECRET_KEY=generate_a_strong_random_secret_key_here_for_sessions
PORT=5000

# Supabase PostgreSQL & API
# Retrieve these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini API
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional MCP Integration (leave disabled if not running an MCP server)
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8000/sse
MCP_AUTH_TOKEN=optional-mcp-token

# Timezone & Regional Settings
APP_TIMEZONE=Asia/Kolkata
UPLOAD_MAX_FILE_SIZE_MB=10
